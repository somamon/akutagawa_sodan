# Anthropic API キー (https://console.anthropic.com/)
NUXT_ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Supabase プロジェクト (https://supabase.com/dashboard)
# Settings > API から取得
NUXT_SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role キー（サーバー専用・絶対にクライアントへ露出させない）
NUXT_SUPABASE_SERVICE_KEY=eyJxxxxxxxx

# デプロイ先のURL（Xシェアのリンク生成に使用）
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- アプリ版（akutagawa_sp）の買い切り課金 ----
# ストアに登録した商品ID。アプリの EXPO_PUBLIC_IAP_PRODUCT_ID と一致させる
NUXT_IAP_PRODUCT_ID=work.akutagawa.app.pro
# iOS: レシート検証に使う。App Store Connect のアプリID（数値）は本番レシートの検証に必須
NUXT_IOS_BUNDLE_ID=work.akutagawa.app
NUXT_IOS_APP_APPLE_ID=
# Android: Play Console >「収益化のセットアップ」のライセンスキー（RSA公開鍵・base64）
NUXT_ANDROID_PACKAGE_NAME=work.akutagawa.app
NUXT_ANDROID_LICENSE_KEY=

# 1日あたりの相談回数。アプリを再配信せずにここだけで調整できる
# Web版（Cookieで識別・買い切りの導線なし）
NUXT_WEB_DAILY_LIMIT=5
# アプリ版（端末IDで識別）
NUXT_FREE_DAILY_LIMIT=3
NUXT_PRO_DAILY_LIMIT=30
# 端末ID・Cookieを作り直して無料枠を取り直す乱用を鈍らせるための、回線単位の日次上限。
# 携帯キャリアのNAT配下では多数の利用者が1つのIPを共有するため、絞りすぎると善意の利用者を巻き込む
NUXT_IP_DAILY_LIMIT=300
